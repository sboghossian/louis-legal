# =============================================================================
# Louis — self-host environment template
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored.
#   cp .env.example .env
# The compose file reads every var below.
# =============================================================================

# -------- Public URLs (what the browser will hit) ----------------------------
# These are baked into the frontend bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# -------- Postgres (bundled service) -----------------------------------------
# The compose file starts a Postgres 15 container with these credentials.
# In production, point DATABASE_URL / SUPABASE_DB_URL at managed Postgres
# (Supabase, RDS, Neon, etc.) and stop the local `postgres` service.
POSTGRES_USER=louis
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=louis
DATABASE_URL=postgresql://louis:change-me-please@postgres:5432/louis
# `npm run migrate` (backend) reads SUPABASE_DB_URL first, then DATABASE_URL.
SUPABASE_DB_URL=postgresql://louis:change-me-please@postgres:5432/louis

# -------- Supabase (auth + storage adapter) ----------------------------------
# Louis was originally built against Supabase. For a fully self-hosted
# install you can run supabase/supabase or point at a managed project.
# Replace these with your project values.
SUPABASE_URL=http://localhost:54321
SUPABASE_SECRET_KEY=replace-with-service-role-key
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=replace-with-anon-key

# -------- Object storage (Minio is bundled; S3/R2-compatible) ----------------
# Minio defaults below. Buckets are created automatically by the
# `minio-init` service on first boot.
MINIO_ROOT_USER=louis
MINIO_ROOT_PASSWORD=change-me-please-minio
MINIO_BUCKET=louis
R2_ENDPOINT_URL=http://minio:9000
R2_ACCESS_KEY_ID=louis
R2_SECRET_ACCESS_KEY=change-me-please-minio
R2_BUCKET_NAME=louis

# -------- Signing secrets (REQUIRED — generate fresh values) -----------------
# Generate each with:  openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=replace-with-openssl-rand-hex-32
USER_API_KEYS_ENCRYPTION_SECRET=replace-with-openssl-rand-hex-32

# -------- LLM provider keys (OPTIONAL — bring your own) ----------------------
# Louis works with any of these; leave commented if you don't use a given
# provider. At least one must be set for the chat features to function.
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENAI_API_KEY=sk-...

# -------- Email (OPTIONAL — Resend) ------------------------------------------
# RESEND_API_KEY=re_...

# -------- Runtime knobs (OPTIONAL — sane defaults) ---------------------------
NODE_ENV=production
# How many proxy hops Express should trust for rate-limit IP detection.
TRUST_PROXY_HOPS=1
# Rate limits (requests per window).
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_UPLOAD_MAX=50
