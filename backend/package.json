{
  "name": "louis-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy-skills",
    "copy-skills": "mkdir -p dist/skills && cp src/skills/*.md dist/skills/",
    "start": "node dist/index.js",
    "skills:registry": "tsx src/skills/_build-registry.ts",
    "skills:import": "tsx src/skills/_import-from-inventory.ts",
    "migrate": "tsx scripts/migrate.ts",
    "worker": "tsx src/queue/worker.ts",
    "worker:prod": "node dist/queue/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@google/genai": "^1.50.1",
    "@supabase/supabase-js": "^2.49.4",
    "@types/pg": "^8.20.0",
    "bullmq": "^5.34.0",
    "cohere-ai": "^7.14.0",
    "cors": "^2.8.5",
    "docx": "^9.5.0",
    "dotenv": "^17.4.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "fast-diff": "^1.3.0",
    "fast-xml-parser": "^5.7.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jszip": "^3.10.1",
    "libreoffice-convert": "^1.6.0",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.2",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.20.0",
    "resend": "^4.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.1",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
